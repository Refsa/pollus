{
  "name": "spinner",
  "types": {
    "Transform2D": "Pollus.Engine.Transform.Transform2D",
    "Sprite": "Pollus.Engine.Rendering.Sprite",
    "Rotate": "Pollus.Examples.SceneExample+Rotate"
  },
  "components": {
    "Transform2D": { "Position": [0, 0], "Scale": [6, 6], "Rotation": 0 },
    "Sprite": {
      "Material": {
        "$type": "Pollus.Engine.Rendering.SpriteMaterial",
        "ShaderSource": "shaders/builtin/sprite.wgsl",
        "Texture": { "Image": "sprites/test_sheet.png", "Visibility": "Fragment" },
        "Sampler": { "Sampler": "nearest", "Visibility": "Fragment" }
      },
      "Slice": { "Min": [0, 0], "Max": [16, 16] },
      "Color": [1, 1, 1, 1]
    },
    "Rotate": { "Speed": 90 }
  },
  "variants": {
    "slow": {
      "Rotate": { "Speed": 30 },
      "Sprite": { "Color": [0.5, 1, 0.5, 1] }
    },
    "fast": {
      "Rotate": { "Speed": 360 },
      "Transform2D": { "Scale": [4, 4] },
      "Sprite": { "Color": [1, 0.5, 0.5, 1] }
    }
  }
}
