{
  "types": {
    "Transform2D": "Pollus.Engine.Transform.Transform2D",
    "Sprite": "Pollus.Engine.Rendering.Sprite",
    "Rotate": "Pollus.Examples.SceneExample+Rotate"
  },
  "imports": {
    "spinner": "prefabs/spinner.prefab"
  },
  "prefabs": {
    "static_sprite": {
      "components": {
        "Transform2D": { "Position": [0, 0], "Scale": [6, 6], "Rotation": 0 },
        "Sprite": {
          "Material": {
            "$type": "Pollus.Engine.Rendering.SpriteMaterial",
            "ShaderSource": "shaders/builtin/sprite.wgsl",
            "Texture": { "Image": "sprites/test_sheet.png", "Visibility": "Fragment" },
            "Sampler": { "Sampler": "nearest", "Visibility": "Fragment" }
          },
          "Slice": { "Min": [0, 0], "Max": [16, 16] },
          "Color": [1, 1, 1, 1]
        }
      }
    }
  },
  "entities": [
    {
      "name": "center_spinner",
      "prefab": "spinner",
      "components": {
        "Transform2D": { "Position": [256, 256], "Scale": [8, 8] }
      }
    },

    {
      "name": "slow_spinner",
      "prefab": "spinner#slow",
      "components": {
        "Transform2D": { "Position": [96, 256] }
      }
    },

    {
      "name": "fast_spinner",
      "prefab": "spinner#fast",
      "components": {
        "Transform2D": { "Position": [416, 256] }
      }
    },

    {
      "name": "orbit_group",
      "prefab": "spinner",
      "components": {
        "Transform2D": { "Position": [256, 96] },
        "Rotate": { "Speed": 45 }
      },
      "children": [
        {
          "name": "orbit_child_left",
          "prefab": "static_sprite",
          "components": {
            "Transform2D": { "Position": [-80, 0], "Scale": [3, 3] },
            "Sprite": { "Color": [0.8, 0.8, 1, 1] }
          }
        },
        {
          "name": "orbit_child_right",
          "prefab": "static_sprite",
          "components": {
            "Transform2D": { "Position": [80, 0], "Scale": [3, 3] },
            "Sprite": { "Color": [1, 0.8, 0.8, 1] }
          }
        }
      ]
    },

    {
      "name": "static_display",
      "prefab": "static_sprite",
      "components": {
        "Transform2D": { "Position": [256, 416], "Scale": [10, 10] },
        "Sprite": { "Color": [1, 1, 0.7, 1] }
      }
    }
  ]
}
